# NanoNets API Accounts Configuration
# This is an example file. Copy this to .env and fill in your actual API keys.
#
# The application supports up to 4 NanoNets API accounts for automatic failover.
# When one account hits rate limits, the system automatically tries the next account.
#
# Format: API_KEY_N=your_api_key (where N is account ID 1-4)
# Failover order: 1 -> 2 -> 3 -> 4
#
# Minimum requirement: At least API_KEY_1 must be configured
# Additional accounts (2, 3, 4) are optional but recommended for high-volume processing

# Account 1 (Required)
API_KEY_1=your_first_nanonets_api_key_here

# Account 2 (Optional - for failover)
# API_KEY_2=your_second_nanonets_api_key_here

# Account 3 (Optional - for failover)
# API_KEY_3=your_third_nanonets_api_key_here

# Account 4 (Optional - for failover)
# API_KEY_4=your_fourth_nanonets_api_key_here
